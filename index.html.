
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Attendance System</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <div class="container">

        <h1>Student Attendance</h1>
        <p class="subtitle">QR Code Attendance System</p>

        <div class="card">

            <h2>Student Information</h2>

            <p id="studentName">Waiting for QR scan...</p>
            <p id="studentSection"></p>

            <input
                type="password"
                id="password"
                placeholder="Enter attendance password"
            >

            <button id="submitBtn" onclick="submitAttendance()">
                Verify & Record Attendance
            </button>

            <p id="status"></p>

        </div>

    </div>

    <script src="script.js"></script>

</body>
</html>
